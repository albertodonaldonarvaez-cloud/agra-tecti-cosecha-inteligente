# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# Credenciales de MySQL para Docker Compose
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=agratec_db
MYSQL_USER=agratec_user
MYSQL_PASSWORD=change_this_user_password

# URL de conexión a la base de datos
DATABASE_URL=mysql://agratec_user:change_this_user_password@db:3306/agratec_db

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

NODE_ENV=production
VITE_APP_TITLE=Agratec - Dashboard de Cosecha de Higo
VITE_APP_LOGO=/logo.svg

# Analytics (opcional - dejar vacío si no se usa)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ============================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================

JWT_SECRET=change_this_to_a_random_secret_at_least_32_characters_long

# ============================================
# FOTOS DE KOBOTOOLBOX
# ============================================

# Carpeta donde se guardan las fotos dentro del contenedor.
# Está montada en el volumen ./photos del docker-compose, así que las
# fotos sobreviven a los reinicios y a las actualizaciones de la imagen.
PHOTOS_DIR=/app/photos

# Descarga automática de las fotos de KoboToolbox al servidor.
# Poner en "false" solo si se quiere seguir dependiendo de Kobo.
KOBO_PHOTO_ARCHIVE=true
